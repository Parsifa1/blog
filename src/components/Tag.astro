---
import IconHash from "@assets/icons/IconHash.svg";

export interface Props {
  tag: string;
  tagName?: string;
  size?: "sm" | "lg";
}

const { tag, tagName, size = "lg" } = Astro.props;
---

<li>
  <a
    href={`/tags/${tag}/`}
    transition:name={tag}
    class:list={[
      "flex items-center gap-0.5",
      "border-b-2 border-dashed border-skin-accent/70",
      "transition-[color,border-color,translate] duration-150 ease-out",
      "hover:-translate-y-0.5 hover:border-skin-accent hover:text-skin-accent",
      "focus-visible:border-none focus-visible:text-skin-accent",
      { "text-sm": size === "sm" },
      { "text-lg": size === "lg" },
    ]}
  >
    <IconHash
      class:list={[
        "opacity-80",
        { "size-5": size === "lg" },
        { "size-4": size === "sm" },
      ]}
    />
    {tagName ?? tag}
  </a>
</li>
