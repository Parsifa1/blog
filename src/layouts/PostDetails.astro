---
import Goback from "@assets/icons/goback.svg";
import Comments from "@components/Comments";
import Datetime from "@components/Datetime";
import Footer from "@components/Footer.astro";
import Header from "@components/Header/Header.astro";
import ShareLinks from "@components/ShareLinks.astro";
import { SITE } from "@config";
import Layout from "@layouts/Layout.astro";
import { slugifyStr } from "@utils/slugify";
import type { CollectionEntry } from "astro:content";
import "@fancyapps/ui/dist/fancybox/fancybox.css";
import "/node_modules/katex/dist/katex.min.css";
import { render } from "astro:content";

export interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;

const {
  title,
  author,
  description,
  ogImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  annotations,
} = post.data;
const { Content } = await render(post);

const ogImageUrl = typeof ogImage === "string" ? ogImage : ogImage?.src;
const ogUrl = new URL(
  ogImageUrl ?? `/posts/${slugifyStr(title)}/index.png`,
  Astro.url.origin,
).href;

const layoutProps = {
  title: `${title} | ${SITE.title}`,
  author,
  description,
  pubDatetime,
  modDatetime,
  canonicalURL,
  ogImage: ogUrl,
  scrollSmooth: true,
};
---

<Layout {...layoutProps}>
  <Header />
  <div class="mx-auto flex w-full max-w-4xl justify-start px-2">
    <button
      class="focus-outline mb-2 mt-8 flex hover:opacity-75"
      onclick="(() => (history.length === 1) ? window.location = '/' : history.back())()"
    >
      <Goback class="inline-block h-6 w-6 fill-skin-base group-hover:fill-skin-accent" />
      <span>Go back</span>
    </button>
  </div>
  <main id="main-content">
    <h1 transition:name={slugifyStr(title)} class="post-title inline-block">
      {title}
    </h1>
    <Datetime
      pubDatetime={pubDatetime}
      modDatetime={modDatetime}
      size="lg"
      className="my-2"
    />
    <div class="post-layout-container relative">
      <article id="article" role="article" class="prose mx-auto mt-8 max-w-4xl">
        <Content />
      </article>

      {
        annotations && annotations.length > 0 && (
          <>
            <aside class="annotations-sidebar" aria-label="Margin Notes">
              {
                annotations.map(note => (
                  <div
                    class="margin-note"
                    id={`note-${note.index}`}
                    data-target={`mark-${note.index}`}
                  >
                    <div class="margin-note-header">
                      <span class="margin-note-num">[{note.index}]</span>
                      <span class="margin-note-time">{note.time}</span>
                    </div>
                    <div class="margin-note-content">{note.content}</div>
                  </div>
                ))
              }
            </aside>

            <div id="mobile-inline-note" class="mobile-inline-note">
              <div class="mobile-inline-note-header">
                <span id="mobile-inline-note-num" class="mobile-inline-note-num"></span>
                <span id="mobile-inline-note-time" class="mobile-inline-note-time"></span>
              </div>
              <div id="mobile-inline-note-body" class="mobile-inline-note-body"></div>
            </div>
          </>
        )
      }
    </div>

    <ul class="my-8"></ul>

    <div class="flex flex-col-reverse items-center justify-between gap-6 sm:flex-row-reverse sm:items-end sm:gap-4">
      <button
        id="back-to-top"
        class="focus-outline whitespace-nowrap py-1 hover:opacity-75"
      >
        <Goback class="inline-block h-6 w-6 rotate-90 fill-skin-base group-hover:fill-skin-accent" />
        <span>Back to Top</span>
      </button>

      <ShareLinks />
    </div>
    <Comments client:only="react" />
  </main>
  <Footer />
</Layout>

<style>
  @reference "@styles/base.css";

  main {
    @apply mx-auto w-full max-w-4xl px-4 pb-12;
  }
  .post-title {
    @apply text-2xl font-semibold text-skin-accent;
  }

  .post-layout-container {
    position: relative;
    width: 100%;
  }

  /* Notion margin note styles */
  :global(.annotated-text) {
    cursor: pointer;
    transition: color 0.2s ease;
    user-select: none;
  }
  :global(.annotated-text.active) {
    color: rgb(var(--color-accent));
  }
  :global(.note-badge) {
    font-family: monospace;
    font-size: 0.75rem;
    font-weight: 600;
    color: rgb(var(--color-accent));
    margin-left: 3px;
    vertical-align: 4px;
    cursor: pointer;
  }

  .annotations-sidebar {
    display: none;
    position: absolute;
    top: 0;
    left: calc(100% + 1.5rem);
    width: 260px;
    height: 100%;
    pointer-events: none;
  }

  @media (min-width: 1280px) {
    .annotations-sidebar {
      display: block;
    }
  }
  .margin-note {
    position: absolute;
    width: 100%;
    font-size: 0.85rem;
    line-height: 1.55;
    color: rgb(var(--color-text-base));
    opacity: 0.9;
    transition: all 0.25s ease;
    cursor: pointer;
    pointer-events: auto;
    padding: 8px 10px;
    border-left: 2px solid transparent;
  }

  .margin-note.active,
  .margin-note:hover {
    opacity: 1;
    transform: translateX(4px);
    border-left-color: rgb(var(--color-accent));
  }
  .margin-note-header {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin-bottom: 2px;
    font-family: monospace;
    font-size: 0.75rem;
  }

  .margin-note-num {
    color: rgb(var(--color-accent));
    font-weight: 600;
  }

  .margin-note-time {
    color: rgb(var(--color-text-base));
    opacity: 0.75;
    font-size: 0.7rem;
  }
  .margin-note-content {
    color: rgb(var(--color-text-base));
    opacity: 1;
    word-break: break-word;
  }

  /* Inline collapsible card for smaller screens */
  .mobile-inline-note {
    display: none;
    margin: 10px 0 16px 0;
    padding: 6px 0 6px 10px;
    border-left: 2px solid rgb(var(--color-accent));
    background: transparent;
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .mobile-inline-note.show {
    display: block;
    opacity: 1;
  }
  .mobile-inline-note-header {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin-bottom: 2px;
    font-family: monospace;
    font-size: 0.75rem;
  }
  .mobile-inline-note-num {
    color: rgb(var(--color-accent));
    font-weight: 600;
  }
  .mobile-inline-note-time {
    color: rgb(var(--color-text-base));
    opacity: 0.75;
    font-size: 0.7rem;
  }
  .mobile-inline-note-body {
    font-size: 0.85rem;
    line-height: 1.5;
    color: rgb(var(--color-text-base));
  }
</style>

<script is:inline data-astro-rerun>
  /** Create a progress indicator
   *  at the top */
  function createProgressBar() {
    // Create the main container div
    const progressContainer = document.createElement("div");
    progressContainer.className = "progress-container fixed top-0 z-10 h-1 w-full bg-skin-fill";

    // Create the progress bar div
    const progressBar = document.createElement("div");
    progressBar.className = "progress-bar h-1 w-0 bg-skin-accent";
    progressBar.id = "myBar";

    // Append the progress bar to the progress container
    progressContainer.appendChild(progressBar);

    // Append the progress container to the document body or any other desired parent element
    document.body.appendChild(progressContainer);
  }
  createProgressBar();

  /** Update the progress bar
   *  when user scrolls */
  function updateScrollProgress() {
    const winScroll = document.body.scrollTop
      || document.documentElement.scrollTop;
    const height = document.documentElement.scrollHeight
      - document.documentElement.clientHeight;
    const scrolled = (winScroll / height) * 100;
    if (document) {
      const myBar = document.getElementById("myBar");
      if (myBar) {
        myBar.style.width = scrolled + "%";
      }
    }
  }
  document.addEventListener("scroll", updateScrollProgress);

  /** Attaches links to headings in the document,
   *  allowing sharing of sections easily */
  function addHeadingLinks() {
    const headings = Array.from(
      document.querySelectorAll("h2, h3, h4, h5, h6"),
    );
    for (const heading of headings) {
      heading.classList.add("group");
      const link = document.createElement("a");
      link.innerText = "#";
      link.className = "heading-link hidden group-hover:inline-block ml-2";
      link.href = "#" + heading.id;
      link.ariaHidden = "true";
      heading.appendChild(link);
    }
  }
  addHeadingLinks();

  /** Align margin notes with annotated text and handle hover sync */
  function setupAnnotations() {
    const marks = Array.from(document.querySelectorAll(".annotated-text"));
    const notes = Array.from(document.querySelectorAll(".margin-note"));
    const container = document.querySelector(".post-layout-container");
    if (!container || marks.length === 0 || notes.length === 0) return;

    function alignPositions() {
      const containerRect = container.getBoundingClientRect();
      let lastBottom = 0;

      notes.forEach(note => {
        const targetId = note.dataset.target;
        if (!targetId) return;
        const mark = document.getElementById(targetId);
        if (!mark) return;

        const markRect = mark.getBoundingClientRect();
        let targetTop = markRect.top - containerRect.top;
        if (targetTop < lastBottom + 12) {
          targetTop = lastBottom + 12;
        }

        note.style.top = `${targetTop}px`;
        lastBottom = targetTop + note.offsetHeight;
      });
    }

    alignPositions();
    window.addEventListener("resize", alignPositions);

    marks.forEach(mark => {
      const targetId = mark.dataset.target;
      if (!targetId) return;
      const note = document.getElementById(targetId);
      if (!note) return;
      const setActive = active => {
        mark.classList.toggle("active", active);
        note.classList.toggle("active", active);
      };
      mark.addEventListener("mouseenter", () => setActive(true));
      mark.addEventListener("mouseleave", () => setActive(false));
      note.addEventListener("mouseenter", () => setActive(true));
      note.addEventListener("mouseleave", () => setActive(false));

      mark.addEventListener("click", e => {
        e.stopPropagation();
        if (window.innerWidth < 1280) {
          const content = note.querySelector(".margin-note-content")?.textContent || "";
          const time = note.querySelector(".margin-note-time")?.textContent || "";
          const num = note.querySelector(".margin-note-num")?.textContent || "";

          const inlineNote = document.getElementById("mobile-inline-note");
          const noteNum = document.getElementById("mobile-inline-note-num");
          const noteTime = document.getElementById("mobile-inline-note-time");
          const noteBody = document.getElementById("mobile-inline-note-body");

          if (inlineNote && noteNum && noteTime && noteBody) {
            const isCurrentOpen = inlineNote.classList.contains("show")
              && inlineNote.dataset.currentMark === mark.id;
            if (isCurrentOpen) {
              inlineNote.classList.remove("show");
              inlineNote.dataset.currentMark = "";
              mark.classList.remove("active");
              note.classList.remove("active");
              return;
            }

            // Toggle active highlight styles
            marks.forEach(m => m.classList.remove("active"));
            notes.forEach(n => n.classList.remove("active"));
            mark.classList.add("active");
            note.classList.add("active");

            noteNum.textContent = num;
            noteTime.textContent = time;
            noteBody.textContent = content;
            inlineNote.dataset.currentMark = mark.id;

            // Insert inline note card immediately below current annotated block
            const parentBlock = mark.closest("p, li, blockquote, div") || mark;
            parentBlock.insertAdjacentElement("afterend", inlineNote);
            inlineNote.classList.add("show");
          }
        } else {
          note.scrollIntoView({ behavior: "smooth", block: "nearest" });
        }
      });
    });

    const handleOutsideClick = (e) => {
      const inlineNote = document.getElementById("mobile-inline-note");
      if (inlineNote && !inlineNote.contains(e.target) && !e.target.closest(".annotated-text")) {
        inlineNote.classList.remove("show");
        inlineNote.dataset.currentMark = "";
        marks.forEach(m => m.classList.remove("active"));
        notes.forEach(n => n.classList.remove("active"));
      }
    };
    document.addEventListener("click", handleOutsideClick);
    document.addEventListener("astro:before-swap", () => {
      document.removeEventListener("click", handleOutsideClick);
      window.removeEventListener("resize", alignPositions);
    }, { once: true });
  }
  setupAnnotations();

  /** Scrolls the document to the top when
   * the "Back to Top" button is clicked. */
  function backToTop() {
    document.querySelector("#back-to-top")?.addEventListener("click", () => {
      document.body.scrollTop = 0; // For Safari
      document.documentElement.scrollTop = 0; // For Chrome, Firefox, IE and Opera
    });
  }
  backToTop();
</script>
